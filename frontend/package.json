{
  "name": "marsgis-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MarsGIS — React + TypeScript + Vite + CesiumJS single-page app. One persistent Mars globe with layer/catalogue/analysis/results workspace modes.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cesium": "1.146.0",
    "immer": "11.1.21",
    "mars-globe": "file:../packages/mars-globe",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uplot": "1.6.32",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
