# MarsGIS frontend environment template.
# Copy to .env.development (dev) or set at build time. All vars are compile-time (VITE_*).

# Base URL of the backend API. In dev the Vite proxy forwards /api and /openapi.json here.
# In production (nginx) this is "/" (same-origin) and nginx reverse-proxies /api.
VITE_API_URL=http://localhost:8000

# Run the whole app offline from bundled synthetic samples (no backend, no Trek).
# true  -> every /api call is served from src/data/* fixtures (clearly labelled SYNTHETIC).
# false -> real backend at VITE_API_URL.
VITE_USE_MOCKS=false

# Default base layer id on first load. One of the four VERIFIED Trek basemaps:
#   viking | mola_clrshade | mola_dem | themis_dayir
VITE_DEFAULT_BASEMAP=viking

# Where Cesium's copied Workers/Assets/Widgets are served from (set in main.tsx).
VITE_CESIUM_BASE_URL=/cesium

# Route Trek basemap tiles through the /trek dev/nginx proxy instead of trek.nasa.gov
# (only needed if a browser/environment blocks the direct cross-origin tile fetch).
VITE_TREK_VIA_PROXY=false
