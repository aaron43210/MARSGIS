/frontend/nginx/              @marsgis/infra

# Application source (owned by their respective concerns).
/engine/src/                  @marsgis/engine
/backend/app/                 @marsgis/backend
/frontend/src/                @marsgis/frontend
/contracts/                   @marsgis/shared-contract
