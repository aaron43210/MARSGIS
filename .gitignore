# ---- MarsGIS .gitignore ----

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
.venv*/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.local
.eslintcache

# Env / secrets
.env
.env.*
!.env.example

# Data: never commit large rasters / archives (bundle only tiny samples explicitly)
*.img
*.IMG
*.qub
*.tif
*.tiff
*.TIF
*.hdf
*.h5
/data/
downloads/
outputs/
storage/
*.sqlite
*.sqlite3
*.db
# allow tiny committed samples / test fixtures and app data
!engine/sample_data/**
!engine/src/marsgis_engine/data/**
!frontend/src/data/**
!**/tests/fixtures/**
# ...but the blanket negation above must NOT re-include bytecode/caches under fixtures
**/tests/fixtures/**/__pycache__/
**/tests/fixtures/**/*.py[cod]
# large real-cube fixture (~1 MB): kept local, regenerate via scripts/make_a2_fixture.py;
# the A2 / vertical-slice tests skip when it is absent (keeps the repo + CI lean)
engine/tests/fixtures/real_mtrdr_subset/

# Cesium build assets copied at build time
frontend/public/cesium/

# OS / editor
.DS_Store
Thumbs.db
# Office lock/temp files (e.g. ~$Document.docx while open in Word)
~$*
.idea/
.vscode/*
!.vscode/extensions.json

# Docker / local
*.log
.pgdata/
pg_data/
redis_data/

# Local validation cube cache (never committed)
.cache/

# Independent local demo folder (never committed)
EXAMPLE/
