# syntax=docker/dockerfile:1.7
# MarsGIS science engine image -> ghcr.io/${GHCR_OWNER}/marsgis-engine
#
# Multi-stage, non-root (uid/gid 10001), Python pinned to 3.12. rasterio is
# installed from PyPI manylinux wheels (vendored GDAL >= 3.8): there is NO system
# libgdal / libgdal-dev and NO `gdalinfo` CLI in the image. The SAM pipeline uses
# the rasterio / numpy / scipy / spectral Python APIs only.
#
# ALTERNATIVE BASE (documented, not the default): when the full GDAL/OGR CLI
# suite or exotic drivers / PROJ grids are required, switch the base to
#   ghcr.io/osgeo/gdal:ubuntu-small-3.12.x   (pin by digest)
# and install the remaining pure-python deps against that system GDAL. Note that
# base couples the Python version to the Ubuntu release, so the 3.12 pin cannot
# be kept on GDAL >= 3.13 (Ubuntu 26.04 ships Python 3.14).
#
# HASHES: if engine/requirements.lock.txt (a `pip-compile --generate-hashes`
# lockfile covering the full dependency closure, generated by the integrator
# against this 3.12 image) is present it is installed with --require-hashes;
# otherwise the pinned-but-unhashed requirements.txt is used. See docker/README.md.
ARG PYTHON_VERSION=3.12

# ----------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim-bookworm AS builder
ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1
# build-essential covers any sdist-only transitive dep; the headline scientific
# wheels (numpy/scipy/rasterio) are manylinux and need no compiler.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
WORKDIR /build
COPY requirements.txt requirements.lock.txt* ./
RUN python -m pip install --upgrade pip \
    && if [ -f requirements.lock.txt ]; then \
         pip install --require-hashes --no-deps -r requirements.lock.txt ; \
       else \
         pip install -r requirements.txt ; \
       fi
# Install the engine package itself (console_script `marsgis-engine` + the bundled
# public-domain MICA .tab package data). No bulk/sample archive is copied in.
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-deps .

# ----------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime
LABEL org.opencontainers.image.title="marsgis-engine" \
      org.opencontainers.image.description="MarsGIS Spectral Angle Mapper engine (candidate matches, NOT confirmed deposits)" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/aaron43210/MARSGIS"
ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    GDAL_NUM_THREADS=ALL_CPUS \
    PROJ_NETWORK=OFF \
    MPLBACKEND=Agg
# rasterio's manylinux wheel vendors GDAL/GEOS/PROJ but still dynamically links a
# few base system libs that slim-bookworm omits. libexpat1 (libexpat.so.1) is
# required by GDAL at runtime to write COG/GeoTIFF output — without it the engine
# computes but cannot write results.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libexpat1 \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin app
COPY --from=builder /opt/venv /opt/venv
USER 10001:10001
WORKDIR /work
ENTRYPOINT ["marsgis-engine"]
CMD ["--help"]
