# ---- MarsGIS backend environment surface ----
# Copy to backend/.env (git-ignored) and adjust. Every value below is the
# zero-setup DEFAULT: with no .env at all the app boots on SQLite + the
# in-process worker + the in-process engine seam, fully offline.

# --- App ---
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO
JSON_LOGS=false
GIT_SHA=
# Comma-separated or JSON list of allowed browser origins (the Vite dev server).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Database ---
# DEFAULT zero-setup SQLite (async aiosqlite driver).
DATABASE_URL=sqlite+aiosqlite:///./storage/marsgis.db
# PRODUCTION PostgreSQL + PostGIS example (uncomment + set):
# DATABASE_URL=postgresql+asyncpg://marsgis:marsgis@db:5432/marsgis
RUN_MIGRATIONS_ON_STARTUP=true
SEED_ON_STARTUP=true

# --- Storage ---
STORAGE_ROOT=./storage

# --- Job queue ---
# inprocess (default, no infra) | arq (requires REDIS_URL + a marsgis-worker process)
JOB_BACKEND=inprocess
REDIS_URL=redis://localhost:6379/0
JOB_CONCURRENCY=2
JOB_TIMEOUT_S=600
MAX_CONCURRENT_JOBS_PER_CLIENT=2
MAX_JOBS_PER_HOUR_PER_CLIENT=20

# --- Engine seam ---
# inprocess (import marsgis_engine) | subprocess (marsgis-engine CLI) | container (docker run)
ENGINE_MODE=inprocess
ENGINE_IMAGE=ghcr.io/OWNER/marsgis-engine:latest
ENGINE_TIMEOUT_S=600
ENGINE_RLIMIT_AS_MB=2048
ENGINE_RLIMIT_CPU_S=600
ENGINE_MAX_PIXELS=4000000
# Cube staging for the engine input:
#   sample  = use the bundled SYNTHETIC cube (engine/sample_data) for every job
#             (offline/CI default; results are flagged SYNTHETIC and are never
#             presented as a real archive detection).
#   archive = stream the real MTRDR _if cube from the PDS Geosciences archive
#             on demand (requires outbound network; size-capped).
ENGINE_CUBE_SOURCE=sample
SAMPLE_CUBE_PATH=../engine/sample_data/sample_crism_nili.img

# --- Security / abuse limits (public, unauthenticated demo) ---
# SECURITY: the API is UNAUTHENTICATED by default. Set REQUIRE_API_KEY=true and
# API_KEYS for any real/public deployment. These limits bound the compute DoS
# surface of the open POST /api/analysis-jobs endpoint.
REQUIRE_API_KEY=false
API_KEYS=[]
MAX_REQUEST_BODY_BYTES=1048576
MAX_AOI_AREA_KM2=250000
MAX_MINERAL_CLASSES=3

# --- Tiles ---
TILE_SIZE=256
TILE_CACHE_ENABLED=false
