# syntax=docker/dockerfile:1.7
# MarsGIS FastAPI backend image -> ghcr.io/${GHCR_OWNER}/marsgis-backend
#
# Multi-stage, non-root (uid/gid 10001), Python pinned to 3.12. rasterio / rio-tiler
# come from PyPI wheels (vendored GDAL >= 3.8); no system libgdal.
#
# The venv (all third-party deps) is copied from the builder; the application
# source is copied to /app and run from there (PYTHONPATH=/app) rather than
# pip-installed into site-packages, so that `alembic.ini` + `app/alembic` resolve
# at runtime and app.config's repo-relative path logic behaves predictably.
#
# arq + redis (the production JOB_BACKEND=arq worker, reused via compose
# --profile worker) are installed pinned so this single image serves both the
# API and the arq worker role.
#
# HASHES: if backend/requirements.lock.txt (generated by the integrator with
# `pip-compile --generate-hashes` against this 3.12 image) is present it is used
# with --require-hashes; otherwise the pinned-but-unhashed requirements.txt is used.
ARG PYTHON_VERSION=3.12

# ----------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim-bookworm AS builder
ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
WORKDIR /build
COPY requirements.txt requirements.lock.txt* ./
RUN python -m pip install --upgrade pip \
    && if [ -f requirements.lock.txt ]; then \
         pip install --require-hashes --no-deps -r requirements.lock.txt ; \
       else \
         pip install -r requirements.txt ; \
       fi
# Production worker extras (JOB_BACKEND=arq). Pinned to backend pyproject [prod].
# If the lockfile already provides them this is a satisfied no-op.
RUN pip install "arq==0.28.0" "redis==8.1.0"

# ----------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime
LABEL org.opencontainers.image.title="marsgis-backend" \
      org.opencontainers.image.description="MarsGIS FastAPI backend (CRISM catalogue, SAM analysis jobs, on-the-fly result tiling)" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/marsgis/marsgis"
ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    STORAGE_ROOT=/data
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin app
COPY --from=builder /opt/venv /opt/venv
WORKDIR /app
COPY alembic.ini ./
COPY app ./app
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh \
    && mkdir -p /data \
    && chown -R 10001:10001 /data /app
USER 10001:10001
EXPOSE 8000
# Capability probe without curl: a tiny urllib call against the real health route.
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD ["python", "-c", "import sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status==200 else 1)"]
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
