# ============================================================================
# MarsGIS — root environment template (orchestration / docker compose).
#
#   cp .env.example .env    # then edit; .env is git-ignored (NEVER commit it)
#
# These values drive `docker compose` (variable substitution + the backend
# env_file). The backend also has backend/.env.example documenting its full
# in-process surface; this root file is the compose-level template.
#
# SECURITY: values marked (SECRET) must be changed for anything beyond local dev.
# The dev stack is UNAUTHENTICATED and binds only 127.0.0.1.
# ============================================================================

# --- Image registry / release ------------------------------------------------
# Repository owner's GitHub login; images publish to ghcr.io/${GHCR_OWNER}/...
GHCR_OWNER=aaron43210
# Image tag used by compose (release.yml overrides with the git tag on publish).
TAG=dev

# --- Published host ports (all bound to 127.0.0.1) ---------------------------
FRONTEND_PORT=8080
BACKEND_PORT=8000
DB_PORT=5432
REDIS_PORT=6379
TITILER_PORT=8001
ADMINER_PORT=8081

# --- PostgreSQL / PostGIS (the `db` service) ---------------------------------
POSTGRES_USER=marsgis
POSTGRES_PASSWORD=change-me          # (SECRET)
POSTGRES_DB=marsgis

# --- Backend database URL ----------------------------------------------------
# DEFAULT compose path = PostgreSQL + PostGIS (the `db` service):
DATABASE_URL=postgresql+asyncpg://marsgis:change-me@db:5432/marsgis
# Zero-setup SQLite fallback (no db container required), e.g. for `make up` minus db:
# DATABASE_URL=sqlite+aiosqlite:///./storage/marsgis.db

# --- Backend app -------------------------------------------------------------
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO
JSON_LOGS=false
# Browser origins allowed by CORS (JSON array or comma list). The dev frontend
# is served same-origin behind nginx on :8080; the host Vite dev server is :5173.
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173"]
# uvicorn workers. Honoured only with JOB_BACKEND=arq: the in-process job
# runner needs a single worker, so the entrypoint forces 1 for it.
WEB_CONCURRENCY=2

# --- Storage (shared raster/result volume mounted at /data in containers) -----
# The backend reads STORAGE_ROOT; compose sets it to /data and mounts the named
# `storage` volume there (shared between backend and the arq worker).
STORAGE_ROOT=/data

# --- Job queue ---------------------------------------------------------------
# inprocess (default, no infra) | arq (requires REDIS_URL + `--profile worker`)
JOB_BACKEND=inprocess
REDIS_URL=redis://redis:6379/0
JOB_CONCURRENCY=2
JOB_TIMEOUT_S=600

# --- Engine seam -------------------------------------------------------------
# inprocess (import marsgis_engine) | subprocess (marsgis-engine CLI) | container
ENGINE_MODE=inprocess
ENGINE_IMAGE=ghcr.io/aaron43210/marsgis-engine:latest
# sample = bundled SYNTHETIC cube (offline/CI; flagged SYNTHETIC, never a real
#          detection) | archive = stream the real MTRDR _if cube on demand.
ENGINE_CUBE_SOURCE=sample

# --- Security / abuse limits (public, unauthenticated demo) ------------------
REQUIRE_API_KEY=false
API_KEYS=[]
SECRET_KEY=change-me                 # (SECRET)

# --- Verified NASA Mars Trek basemaps (surfaced for the frontend/data concerns)
# Grid is equirectangular 2x1 at z0; order {z}/{row=y}/{col=x}; extension per product.
TREK_TILE_TEMPLATE=https://trek.nasa.gov/tiles/Mars/EQ/{product}/1.0.0//default/default028mm/{z}/{y}/{x}.{ext}
TREK_BASEMAP_VIKING=Mars_Viking_MDIM21_ClrMosaic_global_232m        # jpg
TREK_BASEMAP_MOLA_CLRSHADE=Mars_MGS_MOLA_ClrShade_merge_global_463m  # jpg
TREK_BASEMAP_MOLA_DEM=mola128_mola64_merge_90Nto90S_SimpleC_clon0    # png
TREK_BASEMAP_THEMIS_DAYIR=THEMIS_DayIR_ControlledMosaics_100m_v2_oct2018  # png

# --- Data services (ASSUMED; owned/confirmed by the data concern) ------------
ODE_REST_BASE_URL=https://oderest.rsl.wustl.edu/live2/

# --- Frontend build-time config (VITE_*; baked at image build) ---------------
# In the published image the SPA is same-origin behind nginx (VITE_API_URL="/").
VITE_API_URL=/
VITE_USE_MOCKS=false
VITE_DEFAULT_BASEMAP=viking
VITE_CESIUM_BASE_URL=/cesium
VITE_TREK_VIA_PROXY=false
